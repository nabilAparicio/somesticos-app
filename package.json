{
  "name": "app-cotizador",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types --strict-vars=false ./worker/worker-configuration.d.ts && tsc -b && vite build && node scripts/verificar-artefacto.mjs",
    "preview": "vite preview",
    "typecheck": "wrangler types --strict-vars=false ./worker/worker-configuration.d.ts && tsc -b --noEmit",
    "arancel:extraer": "node scripts/arancel/extraer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --strict-vars=false ./worker/worker-configuration.d.ts",
    "postinstall": "wrangler types --strict-vars=false ./worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
