{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "../worker/worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types"
    ],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // Los módulos de `src` que se listan acá son los **puros**: lógica de
  // pantalla sin React y sin DOM. Se enumeran uno por uno en vez de con un
  // glob a propósito. Primero, porque un proyecto `composite` exige que todo
  // archivo de entrada esté listado, así que importar uno sin listarlo falla
  // el `typecheck`. Y segundo, porque la `lib` de este proyecto es ES2022 sin
  // DOM: si alguien le mete un `window` a uno de estos módulos, deja de
  // compilar acá, que es justo la barrera que los mantiene probables en este
  // runner.
  "include": [
    "./**/*.ts",
    "../worker",
    "../src/ruteo.ts",
    "../src/pantallas/clientes/formulario.ts",
    "../src/pantallas/clientes/presentacion.ts",
    "../src/mensajes.ts",
    "../src/pantallas/catalogos/formulario.ts",
    "../src/pantallas/catalogos/plantilla.ts",
    "../src/pantallas/catalogos/presentacion.ts",
    "../src/formatos.ts",
    "../src/pantallas/procesos/formulario.ts",
    "../src/pantallas/procesos/plan.ts",
    "../src/pantallas/procesos/plantilla.ts",
    "../src/pantallas/procesos/presentacion.ts",
    "../src/pantallas/procesos/notas.ts",
    "../src/pantallas/procesos/pendientes.ts"
  ]
}
