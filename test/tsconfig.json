{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "../worker/worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types"
    ],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // Los módulos de `src` que se listan acá son los **puros**: lógica de
  // pantalla sin React y sin DOM. Se enumeran uno por uno en vez de con un
  // glob a propósito. Primero, porque un proyecto `composite` exige que todo
  // archivo de entrada esté listado, así que importar uno sin listarlo falla
  // el `typecheck`. Y segundo, porque la `lib` de este proyecto es ES2022 sin
  // DOM: si alguien le mete un `window` a uno de estos módulos, deja de
  // compilar acá, que es justo la barrera que los mantiene probables en este
  // runner.
  "include": [
    "./**/*.ts",
    "../worker",
    "../src/ruteo.ts",
    "../src/pantallas/clientes/formulario.ts",
    "../src/pantallas/clientes/presentacion.ts",
    "../src/mensajes.ts",
    "../src/bitacora.ts",
    "../src/pantallas/catalogos/formulario.ts",
    "../src/pantallas/catalogos/plantilla.ts",
    "../src/pantallas/catalogos/presentacion.ts",
    // La lógica de las dos pantallas del arancel (T-3 de
    // `odd/tasks/arancel-de-honorarios.md`). Entra en esta lista por lo
    // mismo que las de arriba —es lógica pura, sin React ni DOM— y la
    // barrera de este proyecto le sirve de guardia: importa la conversión de
    // dinero de `cotizaciones/lineas.ts` y `puedeLlevarPrecio` de
    // `worker/arancel/dominio.ts`, y el día que alguien le meta un `window`
    // para leer el fragmento de la URL deja de compilar acá, que es
    // exactamente lo que tiene que pasar: el fragmento lo lee `Arancel.tsx`.
    "../src/pantallas/catalogos/precios.ts",
    // La lógica de la pantalla de módulos (T-2 de
    // `odd/tasks/plantillas-de-modulo.md`). Entra por lo mismo que la de
    // arriba, y de hecho importa de ella: la marca de editado es un solo
    // literal para las tres pantallas que la dibujan. La barrera de este
    // proyecto le sirve de guardia igual — el día que alguien le meta un
    // `document` para leer el valor de un campo, deja de compilar acá, que es
    // exactamente lo que tiene que pasar: los campos los cablea
    // `PlantillasDeModulo.tsx`, que no es lógica.
    "../src/pantallas/catalogos/plantillas.ts",
    "../src/formatos.ts",
    "../src/pantallas/procesos/formulario.ts",
    "../src/pantallas/procesos/plan.ts",
    "../src/pantallas/procesos/plantilla.ts",
    "../src/pantallas/procesos/presentacion.ts",
    "../src/pantallas/procesos/notas.ts",
    "../src/pantallas/procesos/pendientes.ts",
    "../src/pantallas/procesos/pestanas.ts",
    "../src/pantallas/procesos/gastos.ts",
    "../src/pantallas/cotizaciones/formulario.ts",
    // La costura del modal de cliente nuevo. Entra acá por lo mismo que las
    // demás —lógica pura, sin React ni DOM— y la barrera de este proyecto le
    // sirve de guardia doble: importa el borrador de `clientes/formulario.ts`
    // y **no** importa ninguna validación propia, que es el invariante
    // entero de ese módulo.
    "../src/pantallas/cotizaciones/cliente-nuevo.ts",
    // La mecánica pura del combobox que los dos selectores de la pantalla de
    // cotización comparten (T-1 de
    // `odd/tasks/el-selector-de-cliente-busca.md`): qué opciones coinciden,
    // cuál queda activa al mover una flecha y qué dice el campo sobre lo
    // elegido. Entra acá por lo mismo que las demás —no importa React ni toca
    // el DOM— y la barrera de este proyecto le sirve de guardia: el día que
    // alguien le meta un `KeyboardEvent` o un `document`, deja de compilar
    // acá, que es exactamente lo que tiene que pasar. Las teclas las cablea
    // `Combobox.tsx`, que no es lógica.
    "../src/pantallas/cotizaciones/combobox.ts",
    "../src/pantallas/cotizaciones/generar.ts",
    "../src/pantallas/cotizaciones/presentacion.ts",
    "../src/pantallas/cotizaciones/ciclo.ts",
    "../src/pantallas/cotizaciones/modulos.ts",
    "../src/pantallas/cotizaciones/lineas.ts",
    "../src/pantallas/cotizaciones/impresion.ts",
    "../src/pantallas/cotizaciones/plan.ts",
    // `src/api/peticiones.ts` es el primero de esta lista que **no** es un
    // módulo de pantalla: es el cliente HTTP. Entra porque su mapa de 409
    // —`CONFLICTOS`— es lógica pura con una prueba propia, y compila acá sin
    // DOM porque `fetch`, `Request` y `Response` los declaran los tipos del
    // runtime de Workers, que este proyecto ya carga en `types`.
    "../src/api/peticiones.ts",
    // El segundo cliente HTTP de la lista (T-3 de
    // `odd/tasks/armazon-de-aplicacion.md`), y entra por lo mismo que el de
    // arriba: `cargarIdentidad` es lógica pura con prueba propia en
    // `test/identidad-ui.spec.ts`, y compila sin DOM porque lo único que
    // toca —`fetch`, `AbortSignal`, `Response`— lo declaran los tipos del
    // runtime de Workers que este proyecto ya carga en `types`.
    "../src/api/identidad.ts"
  ]
}
