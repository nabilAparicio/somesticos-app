{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // `e2e` viaja con la app y no con Node porque sus pruebas corren código
  // dentro del navegador (`page.evaluate`) y necesitan los tipos del DOM,
  // que son justamente los que este proyecto trae y el de Node no.
  // `worker/db/momentos.ts` viaja con la app por lo mismo que
  // `worker/contract.ts`: es un módulo del Worker **sin dependencias**, y es
  // donde vive la zona horaria del bufete, que las pantallas también
  // necesitan. Listarlo es lo que permite que esté escrita una sola vez: el
  // Worker no puede importar de `src/` sin dar vuelta la flecha, así que el
  // único hogar común es un módulo de `worker/` que no arrastre servidor.
  // `worker/cotizaciones/modulos.ts` y `worker/cotizaciones/lineas.ts`
  // entran por lo mismo y cumplen la misma condición, que **no es «no tener
  // dependencias» sino no tener ninguna importación en tiempo de ejecución**:
  // lo único que importan son tipos de `worker/contract.ts`, que se borran al
  // compilar, así que el bundle del navegador no se lleva ni D1 ni HTTP. Cada
  // uno es la mitad acoplada de un `CHECK` de `0004` —los tipos de módulo y
  // las clases de línea—, y copiarlos a `src/` sería una tercera copia del
  // mismo catálogo.
  "include": [
    "src",
    "e2e",
    "worker/contract.ts",
    "worker/db/momentos.ts",
    "worker/cotizaciones/modulos.ts",
    "worker/cotizaciones/lineas.ts"
  ]
}
